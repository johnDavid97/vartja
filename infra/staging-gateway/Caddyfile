{
	admin off
	auto_https off
	servers {
		max_header_size 16KB
		timeouts {
			read_header 10s
			read_body 120s
			write 120s
			idle 30s
		}
	}
}

:3000 {
	route {
		header {
			Cache-Control "private, no-store"
			X-Robots-Tag "noindex, nofollow, noarchive"
			X-Content-Type-Options nosniff
		}
		# Railway readiness only. Never proxies or returns application data.
		@health {
			path /__gateway_health
			method GET HEAD
		}
		respond @health "ok" 200

		@wrongHost not host {$PUBLIC_HOST}
		respond @wrongHost "Not found" 404

		basic_auth bcrypt "VartJa staging" {
			{$GATE_USER_ONE} {$GATE_HASH_ONE}
			{$GATE_USER_TWO} {$GATE_HASH_TWO}
		}
		# Also override upstream cache headers on successful proxy responses.
		header >Cache-Control "private, no-store"
		request_body {
			max_size 12MB
		}
		reverse_proxy app.railway.internal:3000 {
			# Gateway credentials must never reach Payload. Native auth uses cookies.
			header_up -Authorization
			header_up -Forwarded
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {$PUBLIC_HOST}
		}
	}
}
