{
  "name": "sammen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.5",
    "npm": "^11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:admin-bootstrap": "node --env-file=.env --import tsx tests/integration/admin-bootstrap-isolated.ts",
    "test:admin-security": "node --env-file=.env --import tsx tests/integration/admin-security-isolated.ts",
    "test:dependency-compatibility": "vitest run tests/unit/dependency-compatibility.test.ts && node --import tsx tests/integration/dependency-browser.ts",
    "test:editor": "node --env-file=.env --import tsx tests/integration/visual-editor.ts",
    "test:polls": "node --env-file=.env --import tsx tests/integration/polls.ts",
    "test:admin": "node --env-file=.env --import tsx tests/integration/admin-design.ts",
    "test:dashboard": "npm run build && node --env-file=.env --import tsx tests/integration/admin-dashboard-isolated.ts",
    "test:wedding-routing": "npm run build && node --env-file=.env --import tsx tests/integration/wedding-routing-isolated.ts",
    "test:wedding-branding": "npm run build && node --env-file=.env --import tsx tests/integration/wedding-branding-isolated.ts",
    "test:program": "node --env-file=.env --import tsx tests/integration/program.ts",
    "test:legacy-schedule-removal": "npm run build && node --env-file=.env --import tsx tests/integration/legacy-schedule-removal-isolated.ts",
    "test:homepage": "npm run build && node --env-file=.env --import tsx tests/integration/homepage-isolated.ts",
    "test:post-comments": "npm run build && node --env-file=.env --import tsx tests/integration/post-comments-isolated.ts",
    "test:posts-design": "npm run build && node --env-file=.env --import tsx tests/integration/posts-design-isolated.ts",
    "test:program-activity": "npm run build && node --env-file=.env --import tsx tests/integration/program-activity-isolated.ts",
    "test:household-login": "npm run build && node --env-file=.env --import tsx tests/integration/household-login-isolated.ts",
    "test:household-members": "npm run build && node --env-file=.env --import tsx tests/integration/household-members-isolated.ts && node --env-file=.env --import tsx tests/integration/household-login-isolated.ts && node --env-file=.env --import tsx tests/integration/household-admin-isolated.ts",
    "test:poll-overview": "npm run build && node --env-file=.env --import tsx tests/integration/poll-overview-isolated.ts",
    "test:household-admin": "npm run build && node --env-file=.env --import tsx tests/integration/household-admin-isolated.ts",
    "test:households": "npm run build && node --env-file=.env --import tsx tests/integration/household-registration-isolated.ts",
    "payload": "payload",
    "admin:bootstrap": "node --import tsx scripts/bootstrap-admin.ts",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@payloadcms/db-postgres": "3.94.0",
    "@payloadcms/next": "3.94.0",
    "@payloadcms/richtext-lexical": "3.94.0",
    "@payloadcms/translations": "3.94.0",
    "@payloadcms/ui": "3.94.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns-tz": "^3.2.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.59.0",
    "next": "16.4.6",
    "payload": "3.94.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "^8.20.0",
    "shadcn": "4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "yaml": "2.9.1"
  },
  "overrides": {
    "happy-dom": "21.0.4",
    "dompurify": "3.4.18",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@ts-morph/common": {
      "minimatch": "11.0.9"
    }
  }
}
