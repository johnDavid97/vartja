# Local development only. Generate your own values; never commit .env.
# Set to your final HTTPS domain when hosted, e.g. https://bryllup.example.
# Leave blank locally to use the address where admin was opened.
PUBLIC_SITE_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back this up: changing it invalidates invitations and prevents recovery of existing household codes.
HOUSEHOLD_ACCESS_SECRET=replace-with-a-random-64-character-hex-secret
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://sammen:replace-with-a-random-password@127.0.0.1:5433/sammen
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
